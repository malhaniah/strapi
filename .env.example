# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
HOST=0.0.0.0
PORT=1337
# NODE_ENV=production            # set on Railway

# ---------------------------------------------------------------------------
# Secrets. Generate once, store in Railway, NEVER regenerate.
# Rotating any of these invalidates admin sessions, API tokens, transfer
# tokens, or encrypted settings that were created under the old value.
#   node -e "console.log(require('crypto').randomBytes(16).toString('base64'))"
# ---------------------------------------------------------------------------
APP_KEYS="toBeModified1,toBeModified2,toBeModified3,toBeModified4"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# ---------------------------------------------------------------------------
# Database
# Local dev: sqlite. Railway: postgres with DATABASE_URL from the Postgres
# service (${{Postgres.DATABASE_URL}}). The internal railway URL does not need
# SSL; the public proxy URL needs DATABASE_SSL=true and
# DATABASE_SSL_REJECT_UNAUTHORIZED=false.
# ---------------------------------------------------------------------------
DATABASE_CLIENT=sqlite            # production refuses sqlite; must be postgres on Railway
DATABASE_FILENAME=.tmp/data.db
# DATABASE_URL=postgres://user:pass@host:5432/db
# DATABASE_SSL=false
# DATABASE_SSL_REJECT_UNAUTHORIZED=true
# DATABASE_SCHEMA=public
# DATABASE_POOL_MIN=2
# DATABASE_POOL_MAX=10
# DATABASE_CONNECTION_TIMEOUT=60000

# ---------------------------------------------------------------------------
# Media storage
# local      -> public/uploads (dev only; Railway wipes it on redeploy)
# cloudinary -> external, persistent. Required in production.
# ---------------------------------------------------------------------------
UPLOAD_PROVIDER=local
# CLOUDINARY_NAME=
# CLOUDINARY_KEY=
# CLOUDINARY_SECRET=
# CLOUDINARY_FOLDER=portfolio

# ---------------------------------------------------------------------------
# CORS: comma-separated browser origins allowed to call the API.
# Supports wildcard subdomains for Vercel previews.
# ---------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000
# CORS_ORIGINS=https://your-domain.com,https://*.vercel.app,http://localhost:3000

# ---------------------------------------------------------------------------
# Next.js on-demand revalidation (see docs/revalidation.md)
# When both are set, bootstrap creates/updates a webhook named "next-revalidate"
# that POSTs to the URL on publish/unpublish/delete/update with
# "Authorization: Bearer <secret>". Unset locally: the webhook is left untouched.
# ---------------------------------------------------------------------------
# REVALIDATE_WEBHOOK_URL=https://your-domain.com/api/revalidate
# REVALIDATE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# STRAPI_PLUGIN_I18N_INIT_LOCALE_CODE=ar   # first locale on a fresh DB; bootstrap enforces ar anyway
# STRAPI_TELEMETRY_DISABLED=true
# FLAG_NPS=false
# FLAG_PROMOTE_EE=false
# WEBHOOKS_POPULATE_RELATIONS=false
